{
  "routes": [
    { "src": "^/$", "dest": "/api/index" },
    { "src": "^/admin/?$", "dest": "/api/admin" },
    { "src": "^/(private|docs|lib|test)(/.*)?$", "status": 404 },
    { "handle": "filesystem" }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "index.html"
    },
    "api/admin.js": {
      "includeFiles": "private/**"
    },
    "api/docs.js": {
      "maxDuration": 60
    }
  }
}
